# Kopieren nach .env und anpassen.

# IP-Adresse des Receivers (feste IP im Router vergeben)
DENON_HOST=192.168.0.162
# Telnet-Port des Denon AVR Control Protocol
DENON_PORT=23

# Optional: IP-Adresse eines Philips-Fernsehers mit jointSPACE (Port 1925).
# Leer lassen, wenn keine Fernseher-Karte gewünscht ist.
TV_HOST=192.168.0.210

# Cover nachschlagen, wenn HEOS keins liefert (z. B. Bluetooth): schickt Interpret und Titel
# an die öffentliche iTunes-Suche von Apple. "off" schaltet das ab.
COVER_LOOKUP=on

# Höchste Lautstärke, die die Web-UI einstellen kann (Skala 0–98; Gerät selbst begrenzt auf 60).
# Gilt nur für die Web-UI, nicht für Fernbedienung, Drehknopf oder HEOS-App.
MAX_VOLUME=45

# Port, unter dem die Web-UI auf dem Host erreichbar ist
WEB_PORT=8000

# DEBUG zeigt jeden gesendeten und empfangenen Telnet-Befehl
LOG_LEVEL=INFO
